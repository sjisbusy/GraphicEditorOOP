<Window x:Class="GraphicEditorOOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор (ООП Лабораторная)" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#F0F0F0">
            <TextBlock Text="Инструменты" FontWeight="Bold" Margin="0,10,0,10" FontSize="14"/>

            <RadioButton x:Name="BtnPencil" Content="✏️ Карандаш" IsChecked="True" Margin="0,0,0,5" Padding="5" Checked="Tool_Checked"/>
            <RadioButton x:Name="BtnLine" Content="📏 Прямая линия" Margin="0,0,0,5" Padding="5" Checked="Tool_Checked"/>
            <RadioButton x:Name="BtnRectangle" Content="🟩 Прямоугольник" Margin="0,0,0,5" Padding="5" Checked="Tool_Checked"/>
            <RadioButton x:Name="BtnEllipse" Content="⭕ Эллипс" Margin="0,0,0,15" Padding="5" Checked="Tool_Checked"/>

            <Separator Margin="0,0,0,15"/>

            <TextBlock Text="Настройки линии" FontWeight="Bold" Margin="0,0,0,10" FontSize="14"/>

            <TextBlock Text="Цвет:" Margin="0,0,0,3"/>
            <ComboBox x:Name="ComboColor" Margin="0,0,0,10" SelectedIndex="0" SelectionChanged="ComboColor_SelectionChanged">
                <ComboBoxItem Content="Черный" Tag="Black"/>
                <ComboBoxItem Content="Красный" Tag="Red"/>
                <ComboBoxItem Content="Синий" Tag="Blue"/>
                <ComboBoxItem Content="Зеленый" Tag="Green"/>
                <ComboBoxItem Content="Желтый" Tag="Yellow"/>
            </ComboBox>

            <TextBlock Text="Толщина:" Margin="0,0,0,3"/>
            <Slider x:Name="SliderWidth" Minimum="1" Maximum="20" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,5" ValueChanged="SliderWidth_ValueChanged"/>
            <TextBlock x:Name="TxtWidthValue" Text="2 px" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="Gray"/>

            <Separator Margin="0,0,0,15"/>

            <Button x:Name="BtnClear" Content="🗑️ Очистить холст" Margin="0,0,0,8" Padding="8" Click="BtnClear_Click"/>
            <Button x:Name="BtnSave" Content="💾 Сохранить рисунок" Padding="8" Click="BtnSave_Click"/>
        </StackPanel>

        <Border Grid.Column="1" Background="DarkGray" Padding="10">
            <Border x:Name="CanvasBorder" Background="White" CornerRadius="3" ClipToBounds="True">
                <Grid x:Name="CanvasContainer" Background="White"/>
            </Border>
        </Border>
    </Grid>
</Window>
