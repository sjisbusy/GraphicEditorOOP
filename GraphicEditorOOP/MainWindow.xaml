<Window x:Class="GraphicEditorOOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор (ООП Лабораторная)" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>

                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DCDCDC"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#111111"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0" Padding="12,15,12,15">
            <StackPanel>
                <TextBlock Text="Инструменты" FontWeight="SemiBold" Margin="4,0,0,12" FontSize="14" Foreground="#FFFFFF"/>

                <RadioButton x:Name="BtnPencil" Content="✏️  Карандаш" IsChecked="True" Checked="Tool_Checked"/>
                <RadioButton x:Name="BtnLine" Content="📏  Прямая линия" Checked="Tool_Checked"/>
                <RadioButton x:Name="BtnRectangle" Content="🟩  Прямоугольник" Checked="Tool_Checked"/>
                <RadioButton x:Name="BtnEllipse" Content="⭕  Эллипс" Checked="Tool_Checked"/>

                <Separator Margin="0,8,0,15" Background="#3F3F46"/>

                <TextBlock Text="Настройки линии" FontWeight="SemiBold" Margin="4,0,0,12" FontSize="14" Foreground="#FFFFFF"/>

                <TextBlock Text="Цвет:" Margin="4,0,0,5" Foreground="#AAAAAA" FontSize="12"/>
                <ComboBox x:Name="ComboColor" SelectedIndex="0" SelectionChanged="ComboColor_SelectionChanged">
                    
                    <ComboBoxItem Content="Черный" Tag="#000000"/>
                    <ComboBoxItem Content="Серый" Tag="#7F8C8D"/>
                    
                    <ComboBoxItem Content="Бордовый" Tag="#800020"/>
                    <ComboBoxItem Content="Красный" Tag="#D32F2F"/>
                    <ComboBoxItem Content="Розовый" Tag="#FF85A2"/>
                    
                    <ComboBoxItem Content="Оранжевый" Tag="#FF6F00"/>
                    <ComboBoxItem Content="Коричневый" Tag="#5C4033"/>
                    <ComboBoxItem Content="Желтый" Tag="#F1C40F"/>
                    
                    <ComboBoxItem Content="Хвойный зеленый" Tag="#0A3613"/>
                    <ComboBoxItem Content="Зеленый" Tag="#228B22"/>
                    <ComboBoxItem Content="Светло-зеленый" Tag="#2ECC71"/>
                    
                    <ComboBoxItem Content="Синий" Tag="#0D47A1"/>
                    <ComboBoxItem Content="Голубой" Tag="#3498DB"/>
                    <ComboBoxItem Content="Фиолетовый" Tag="#8E44AD"/>
                </ComboBox>


                <TextBlock Text="Толщина:" Margin="4,0,0,3" Foreground="#AAAAAA" FontSize="12"/>
                <Slider x:Name="SliderWidth" Minimum="1" Maximum="20" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,5" ValueChanged="SliderWidth_ValueChanged"/>
                <TextBlock x:Name="TxtWidthValue" Text="2 px" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#FFFFFF" FontWeight="SemiBold"/>

                <Separator Margin="0,5,0,15" Background="#3F3F46"/>

                <Button x:Name="BtnClear" Content="🗑️  Очистить холст" Click="BtnClear_Click"/>
                <Button x:Name="BtnSave" Content="💾  Сохранить рисунок" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#1E1E1E" Padding="15">
            <Border x:Name="CanvasBorder" Background="White" CornerRadius="5" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="CanvasContainer" Background="White"/>
            </Border>
        </Border>
    </Grid>
</Window>
